	(text "Pin 1: VDD Target\nPin 2: RESET\nPin 3: SW_DIO\nPin 4: SW_CLK\nPin 5: GND"
		(exclude_from_sim no)
		(at 265.176 92.202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "78a2dd5f-dd48-441c-80c0-fe4b96e8c9fe")
	)
	(text "Crystal :  X49SM8MSD2SC @ 20pF\nC_{s} = 7pF , target C_{L} = 20pF\nC_{L1}, C_{L2} = 26pF\nR_{ext} = 0 Ohm"
		(exclude_from_sim no)
		(at 70.358 167.386 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "85eee1f3-5eb9-429a-8f47-c7a7a1ac8b85")
	)
	(text "V_{DD} Bypass Capacitor"
		(exclude_from_sim no)
		(at 206.502 15.494 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "916017dc-b4d5-424f-b669-2e0ebe26d3c0")
	)
	(text "V_{DDA} Bypass Capacitor"
		(exclude_from_sim no)
		(at 207.01 50.292 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a28af50e-6237-40af-a6e5-380fb1bf9a0b")
	)
	(text "Crystal Oscillator Tuning Notes (Ref: AN2867)\nFormula: C_{L} =  (C_{L1} * C_{L2}) / (C_{L1} + C_{L2}) + C_{s}\nStray Cap (C_{s}): Typically 5pF. Longer PCB traces increase C_{s}.\nTarget C_{L}: Must match the crystal datasheet specification.\nR_{ext}: Limits drive current to prevent crystal damage."
		(exclude_from_sim no)
		(at 15.748 145.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ad1ee422-c831-4f5c-a799-9fc1b10c635d")
	)
	(text "If C_{L} is too high: Slower startup, lower frequency, requires higher drive current.\nIf C_{L} is too low: Faster startup, higher frequency, risks crystal damage due to overcurrent.\n"
		(exclude_from_sim no)
		(at 15.494 193.294 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bfe14477-437f-4ea6-b1eb-e7ed6ea05297")
	)
