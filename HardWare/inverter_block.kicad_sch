	)
	(text "Bootstrap Capacitor Sizing Calculation\n\nRequired Parameters:\nV_{GVDD}       : Gate drive supply voltage 12V\nQ_{G}          : Total MOSFET gate charge : 92 nC (From IRFH7440 datasheet)\nI_{LBS_TRAN}   : Bootstrap pin leakage current :220uA (Typical driver leakage)\nf_{SW}         : PWM switching frequency : 20kHz\nDelta V_{BSTX} : Maximum allowed voltage drop (Ripple margin) : 1V (Recommend target)\n\nApplying the Formula:\nTotal Charge (Q_{TOT}) = Q_{G} + (I_{LBS_TRAN} / f{SW})\nQ_{TOT} = 92 nC + (220 uA / 20 kHz) \nQ_{TOT} = 92 nC + 11 nC = 103 nC\nC_{BST_MIN} = Q_{TOT} / Delta V_{BSTX} = 103 nF"
		(exclude_from_sim no)
		(at 13.462 111.506 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b40ff79f-c2e0-4766-8373-116998969ccd")
	)
